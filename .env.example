# GitHub verifies incoming webhook deliveries with this shared secret.
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-value

# Production GitHub App credentials. Mount the private key outside the image.
GITHUB_APP_ID=replace-with-github-app-id
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem

# Optional local-development alternative to the GitHub App credentials above.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

ANTHROPIC_API_KEY=replace-with-an-anthropic-api-key
AEGIS_MODEL=replace-with-an-available-anthropic-model-id

AEGIS_DATABASE_PATH=./data/aegis.db
